{
  "name": "french-vocabulary-backend",
  "version": "1.0.0",
  "description": "Backend for French Vocabulary Master",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
